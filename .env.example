# ===========================================
# AppAsistencia - Variables de Entorno (Ejemplo)
# ===========================================
# Copiar este archivo como .env y ajustar los valores

# Django
DJANGO_SECRET_KEY=cambiar-esta-clave-secreta-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL
POSTGRES_DB=asistencia_db
POSTGRES_USER=asistencia_user
POSTGRES_PASSWORD=tu_password_seguro
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Superusuario inicial
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@colegio.edu
DJANGO_SUPERUSER_PASSWORD=CambiameEnProduccion123!

